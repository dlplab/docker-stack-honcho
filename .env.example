# Set as Portainer stack environment variables (never commit real values)
FQDN_HONCHO=honcho.svc.dlplab.tech
# Password must be URL-safe (e.g. openssl rand -hex 32) or percent-encoded
DB_CONNECTION_URI=postgresql+psycopg://honcho:change-me@postgres:5432/honcho
# URL-safe: openssl rand -hex 32
REDIS_PASSWORD=change-me
# openssl rand -hex 32
AUTH_JWT_SECRET=change-me
# At least one LLM provider key (defaults use OpenAI gpt-5.4-mini + text-embedding-3-small)
LLM_OPENAI_API_KEY=
# LLM_ANTHROPIC_API_KEY=
# LLM_GEMINI_API_KEY=
# Optional
# AUTH_USE_AUTH=true
# DERIVER_FLUSH_ENABLED=false
# LOG_LEVEL=INFO
